# Copy this file to ".env" and fill in your own values. Never share the .env file.

# --- Fyers API app (create at https://myapi.fyers.in/dashboard) ---
# App ID looks like: ABCD1234EF-100
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
# Must match EXACTLY the Redirect URL you entered when creating the Fyers app
FYERS_REDIRECT_URI=http://127.0.0.1:8765/fyers/callback

# --- Optional: Telegram alerts (create a bot with @BotFather, get chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
